MONGODB_URI=mongodb://127.0.0.1:27017
SONG_CATALOG_DB=piugame_sdk
PHOENIX_CATALOG_COLLECTION=song_catalog
PHOENIX2_CATALOG_COLLECTION=song_catalog_2
FEATURED_SHOWCASE_SONG_SLUG=freedom-dive-xi-phoenix2
NEXT_PUBLIC_SITE_URL=https://mypiu.austin.kim
COMMUNITY_DB_NAME=piugame_web
COMMUNITY_USERS_COLLECTION=users
COMMUNITY_SESSIONS_COLLECTION=auth_sessions
COMMUNITY_SAVED_SONGS_COLLECTION=saved_songs
COMMUNITY_TAG_CONTRIBUTIONS_COLLECTION=song_tag_contributions
COMMUNITY_TAG_VOTES_COLLECTION=song_tag_votes
COMMUNITY_NOTES_COLLECTION=song_notes
COMMUNITY_POSTS_COLLECTION=song_community_posts
FEEDBACK_COLLECTION=site_feedback
SITE_LOGS_COLLECTION=site_logs
SITE_ADMIN_EMAILS=owner@example.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_BOT_DB_NAME=piugame_discord
OAUTH_ALLOWED_ORIGINS=http://localhost:3000,https://your-dev-tunnel.example.com,https://mypiu.austin.kim
# Optional provider-specific overrides. Leave unset to use the request origin.
# GOOGLE_OAUTH_ORIGIN=http://localhost:3000
# DISCORD_OAUTH_ORIGIN=http://localhost:3000
CREDENTIAL_ENCRYPTION_KEY=32-byte-hex-base64-or-utf8-secret
MOBILE_OAUTH_REDIRECT_URIS=mypiu://oauth/callback
# Optional collection overrides. Defaults are shown.
MOBILE_OAUTH_CODES_COLLECTION=mobile_oauth_codes
MOBILE_ACCESS_TOKENS_COLLECTION=mobile_access_tokens
MOBILE_IMPORTS_COLLECTION=mobile_sync_imports
MOBILE_SYNC_LOCKS_COLLECTION=mobile_sync_locks
MOBILE_RATE_LIMITS_COLLECTION=mobile_sync_rate_limits
